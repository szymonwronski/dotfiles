(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc   f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  lsgt  1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]
  caps  a     s     d     f     g     h     j     k     l     ;     '     \     ret
  lsft  grv   z     x     c     v     b     n     m     ,     .     /     rsft
  fn    lctl  lalt  lmet              spc               rmet  ralt  ◀    ▲ ▼    ▶  
)

(deflayer base
  esc     🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
  lsgt  1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]
  @caps @a    @s    @d    @f    g     h     @j    @k    @l    @;    '     \     ret
  lsft  grv   z     x     c     v     b     n     m     ,     .     /     rsft
  @fn   lctl  lalt  lmet             spc               @rmet ralt  ◀    ▲ ▼    ▶
)

(deflayer colemak-dh
  esc     🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
  lsgt  1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     f     p     b     j     l     u     y     ;     [     ]
  @caps @ac   @rc   @sc   @tc   g     m     @nc   @ec   @ic   @oc   '     \     ret
  lsft  z     x     c     d     v     grv   k     h     ,     .     /     rsft
  @fn   lctl  lalt  lmet             spc              @rmet  ralt  ◀     ▲ ▼    ▶
)

(deflayer fn
  _     f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  _     _     _     _     _     _     _     _     _     _     _     _     _     del
  _     _     _     _     lrld  _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     @tocolemak  _     @tobase     @tonomods   _     _     _     _     _
  _     _     _     _                 _                 _     _     ⤒    ⇞ ⇟    ⤓
)

(deflayer nomods
  esc     🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
  lsgt  1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]
  @caps a     s     d     f     g     h     j     k     l     ;     '     \     ret
  lsft  grv   z     x     c     v     b     n     m     ,     .     /     rsft
  @fn   lctl  lalt  lmet              spc               rmet  ralt  ◀    ▲ ▼    ▶
)

(defhands
  (left  q w e r t a s d f g ` z x c v b)
  (right y u i o p h j k l ; n m , . /)
)

(defvar
  tap-time 200
  hold-time 150
  hold-pinky 175
  hold-ring 165
  hold-mid   150
  hold-index 150

  left-hand-keys (
    q w e r t
            g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h
    n m , . /
  )
)

(deffakekeys
  to-base (layer-switch base)
)

(defalias
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  fn (tap-hold $tap-time $hold-time fn (layer-while-held fn))

  caps (tap-hold $tap-time $hold-time esc (layer-while-held nav))
  rmet (tap-hold $tap-time $hold-time ret rmet)

  a (tap-hold-release-keys $tap-time $hold-pinky (multi a @tap) lctl $left-hand-keys)
  s (tap-hold-release-keys $tap-time $hold-ring (multi s @tap) lalt $left-hand-keys)
  d (tap-hold-release-keys $tap-time $hold-mid (multi d @tap) lmet $left-hand-keys)
  f (tap-hold-release-keys $tap-time $hold-index (multi f @tap) lsft $left-hand-keys)

  j (tap-hold-release-keys $tap-time $hold-index (multi j @tap) rsft $right-hand-keys)
  k (tap-hold-release-keys $tap-time $hold-mid (multi k @tap) rmet $right-hand-keys)
  l (tap-hold-release-keys $tap-time $hold-ring (multi l @tap) ralt $right-hand-keys)
  ; (tap-hold-release-keys $tap-time $hold-pinky (multi ; @tap) rctl $right-hand-keys)

  ac (tap-hold-opposite-hand $tap-time $hold-pinky a lctl)
  rc (tap-hold-opposite-hand $tap-time $hold-ring r lalt)
  sc (tap-hold-opposite-hand $tap-time $hold-mid s lmet)
  tc (tap-hold-opposite-hand $tap-time $hold-index t lsft)

  nc (tap-hold-opposite-hand $tap-time $hold-index n rsft)
  ec (tap-hold-opposite-hand $tap-time $hold-mid e rmet)
  ic (tap-hold-opposite-hand $tap-time $hold-ring i ralt)
  oc (tap-hold-opposite-hand $tap-time $hold-pinky o rctl)

  tobase (layer-switch base)
  tocolemak (layer-switch colemak-dh)
  tonomods (layer-switch nomods)
)

(deflayermap (nav)
  j left
  k down
  l up
  ; right

  u bspc
  i ret
)
